# Local credentials and machine-specific configuration
.env
.env.*
!.env.example

# Shared packaging/test scratch state; source and release manifests stay tracked.
/build/
# Team-skill archives are GitHub Release assets (tools/publish_team_skills.py).
/release/team-skills/*/*.zip
/release/team-skills/*/*.skill
# Durable local source material; retain between research runs, never package/push.
/research/library/transcripts/
/research/library/audio/
/research/library/.venv/
/research/library/notes/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
