{
  "name": "@manacost/hearthstone-replay",
  "version": "0.4.0",
  "description": "Lossless parser and state engine for Hearthstone HSReplay XML files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manacost-Labs/hearthstone-replay.git"
  },
  "homepage": "https://github.com/Manacost-Labs/hearthstone-replay#readme",
  "bugs": {
    "url": "https://github.com/Manacost-Labs/hearthstone-replay/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js . && node node_modules/prettier/bin/prettier.cjs --check .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:property": "node node_modules/vitest/vitest.mjs run test/property",
    "test:corpus": "node node_modules/vitest/vitest.mjs run test/corpus",
    "test:golden": "UPDATE_GOLDEN=1 node node_modules/vitest/vitest.mjs run test/integration/golden.test.ts",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "corpus:verify": "node scripts/corpus/verify-manifest.mjs",
    "corpus:stats": "node scripts/corpus/semantic-stats.mjs",
    "differential": "node scripts/differential/compare.mjs",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "keywords": [
    "hearthstone",
    "hsreplay",
    "replay",
    "parser",
    "typescript"
  ],
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  }
}
