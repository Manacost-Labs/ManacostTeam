# Copy to .env and fill only services you actually use. Never commit real credentials.

# EditorTeam: use "none" for local checks without an LLM.
EDITOR_PROVIDER=none
EDITOR_MODEL=
EDITOR_API_KEY=
EDITOR_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# EditorTeam: ChatGPT-authenticated AG-UI route (optional; replaces EDITOR_API_KEY).
EDITOR_AGUI_URL=
EDITOR_AGUI_TOKEN=
EDITOR_AGENT_TOKEN=

# ResearchTeam: optional provider credentials. Empty values disable that provider.
REDDITAPIS_KEY=
GETXAPI_KEY=
TRANSCRIPTAPI_TOKEN=
TINYFISH_API_KEY=
SCRAPE_DO_API_TOKEN=
KHS_API_TOKEN=
